# GoPay Payment Gateway Configuration
# Test Environment (Sandbox):
# 1. Register at https://www.gopay.com/
# 2. Create test account and get credentials from dashboard
# 3. Set GOPAY_ENVIRONMENT=test
#
# Production Environment:
# 1. Contact GoPay for merchant account
# 2. Get production credentials
# 3. Set GOPAY_ENVIRONMENT=production

GOPAY_CLIENT_ID=your_goid_here
GOPAY_CLIENT_SECRET=your_client_secret_here
GOPAY_ENVIRONMENT=test
